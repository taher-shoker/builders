{
  "name": "app-sector",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "prefix": "stc-apps",
  "sourceRoot": "apps/app-sector/src",
  "tags": [],
  "targets": {
    "build": {
      "executor": "@angular-devkit/build-angular:application",
      "outputs": [
        "{options.outputPath}"
      ],
      "options": {
        "outputPath": "dist/apps/app-sector",
        "index": "apps/app-sector/src/index.html",
        "browser": "apps/app-sector/src/main.ts",
        "polyfills": [
          "zone.js"
        ],
        "tsConfig": "apps/app-sector/tsconfig.app.json",
        "inlineStyleLanguage": "scss",
        "assets": [
          "apps/app-sector/src/favicon.ico",
          "apps/app-sector/src/assets",
          {
            "input": "libs/shared-ui/src/assets",
            "glob": "**/*",
            "output": "assets"
          }
        ],
        "styles": [
          "libs/styles/src/index.scss",
          "node_modules/ngx-toastr/toastr.css",
          "node_modules/ngx-spinner/animations/ball-scale-multiple.css",
          "node_modules/quill/dist/quill.snow.css",
          "apps/app-sector/src/styles.scss"
        ],
        "stylePreprocessorOptions": {
          "includePaths": [
            "libs/styles/src"
          ]
        },
        "scripts": [
          "node_modules/bootstrap/dist/js/bootstrap.bundle.min.js"
        ]
      },
      "configurations": {
        "production": {
          "fileReplacements": [
            {
              "replace": "apps/app-sector/src/environments/environment.ts",
              "with": "apps/app-sector/src/environments/environment.prod.ts"
            }
          ],
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "500kb",
              "maximumError": "5mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "2kb",
              "maximumError": "4kb"
            }
          ],
          "outputHashing": "all"
        },
        "staging": {
          "fileReplacements": [
            {
              "replace": "apps/app-sector/src/environments/environment.ts",
              "with": "apps/app-sector/src/environments/environment.staging.ts"
            }
          ],
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "500kb",
              "maximumError": "5mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "2kb",
              "maximumError": "4kb"
            }
          ],
          "outputHashing": "all"
        },
        "development": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true
        }
      },
      "defaultConfiguration": "production"
    },
    "serve": {
      "executor": "@angular-devkit/build-angular:dev-server",
      "configurations": {
        "production": {
          "buildTarget": "app-sector:build:production"
        },
        "development": {
          "buildTarget": "app-sector:build:development"
        }
      },
      "defaultConfiguration": "development"
    },
    "extract-i18n": {
      "executor": "@angular-devkit/build-angular:extract-i18n",
      "options": {
        "buildTarget": "app-sector:build"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": [
        "{workspaceRoot}/coverage/{projectRoot}"
      ],
      "options": {
        "jestConfig": "apps/app-sector/jest.config.ts"
      }
    },
    "serve-static": {
      "executor": "@nx/web:file-server",
      "options": {
        "buildTarget": "app-sector:build",
        "staticFilePath": "dist/apps/app-sector/browser"
      }
    }
  }
}
